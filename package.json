{
  "name": "jala-cssd-245-qatu-catalog-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Qatu Marketplace catalog frontend with server-side product search and pagination.",
  "license": "MIT",
  "author": "Diego Alejandro Botina",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.17.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "screenshots": "node scripts/generate-screenshots.js",
    "pdf": "node scripts/generate-pdf.js",
    "screenshots:pdf": "pnpm screenshots && pnpm pdf"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
